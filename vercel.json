{
  "buildCommand": "yarn build:vigil:cloud",
  "installCommand": "yarn install",
  "outputDirectory": "platform/app/dist",
  "functions": {
    "api/pacs.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/pacs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/pacs/(.*)",
      "destination": "/api/pacs?orthancPath=$1"
    },
    {
      "source": "/((?!api/|pacs/).*)",
      "destination": "/index.html"
    }
  ]
}
